{
  "name": "gearmatch-ai-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "GearMatch AI v2.0 — mobile web MVP (Animal Identity B-Lite)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:identity": "tsx scripts/test-identity.ts",
    "check:assets": "node scripts/check-assets.mjs",
    "lint": "eslint .",
    "test:onboarding": "tsx scripts/test-onboarding.ts",
    "check:supabase": "node scripts/check-supabase.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "test:delete": "node scripts/test-delete.mjs",
    "test:stats": "tsx scripts/test-stats.ts",
    "verify:sql": "node scripts/verify-sql.mjs && tsx scripts/verify-items-sql.mts && node scripts/verify-delete-sql.mjs",
    "items:import": "tsx scripts/items/import.ts",
    "items:demo": "tsx scripts/items/generate-demo.ts",
    "test:items": "tsx scripts/test-items.ts",
    "test:analytics": "tsx scripts/test-analytics.ts && tsx scripts/test-dashboards.mts",
    "posthog:check": "node scripts/posthog/check-dashboards.mjs",
    "posthog:dashboard": "node scripts/posthog/create-dashboard.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "next": "^15.5.4",
    "posthog-js": "^1.435.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "ajv": "^8.17.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.x",
    "exceljs": "^4.4.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
