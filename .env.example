# Copy this file to .env.local and fill in the values (STEP 3 — Supabase).
# Never commit .env.local. Do not paste the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# demo | real — while Supabase is not connected the app runs on DEMO data only.
NEXT_PUBLIC_DATA_MODE=demo

# Local-only ITEMS DEMO runners (docs/ITEMS_DATA.md). Ignored in server mode. Leave empty in deployments.
NEXT_PUBLIC_ITEMS_DEMO=
